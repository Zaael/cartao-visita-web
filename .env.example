# Copie para .env.local e preencha com os valores do painel do Supabase
# (Project Settings > API Keys). O .env.local e' ignorado pelo git.
#
# Os nomes seguem o que o painel do Supabase gera hoje. Nem tudo esta' em uso:
# a coluna "usado por" diz quem le' cada uma.

# --- em uso ---------------------------------------------------------------

# usado por: scripts/seed.ts, e pelas queries em Server Component (fase 1.5)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key: pode ir para o browser, quem protege os dados e' o RLS.
# usado por: queries publicas (fase 1.5)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key: IGNORA o RLS. Nunca commite e nunca use em Client Component.
# Em projetos mais antigos aparece como "service_role key" — o valor serve igual.
# usado por: scripts/seed.ts (e, na fase 5, o webhook de pagamento)
SUPABASE_SECRET_KEY=

# URL publica do site, usada para resolver as imagens de Open Graph.
# Sem ela o Next usa http://localhost:3000. Preencher no deploy (fase 1.7),
# ex: https://cartao-visita.<sua-conta>.workers.dev
NEXT_PUBLIC_SITE_URL=

# --- ainda sem uso no codigo ----------------------------------------------

# Duplicatas sem o prefixo NEXT_PUBLIC_, para codigo que roda so' no servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Verificacao de JWT — vai ser usada quando o Supabase Auth entrar (fase 4).
SUPABASE_JWKS_URL=
